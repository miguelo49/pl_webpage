<div class="space-y-8">
  <div>
    <h2 class="text-xl font-semibold text-gray-900">Contexto político</h2>
    <p class="mt-1 text-sm text-gray-500">Próximos eventos y noticias relevantes del partido y la región.</p>
  </div>

  <section class="space-y-4">
    <div class="flex items-center justify-between gap-3">
      <h3 class="text-base font-semibold text-gray-900">Próximos eventos</h3>
      <span class="text-xs text-gray-400"><%= @upcoming_events.size %></span>
    </div>

    <div class="space-y-3">
      <% if @upcoming_events.any? %>
        <% @upcoming_events.each do |event| %>
          <%= render "political_contexts/event_card", event: event %>
        <% end %>
      <% else %>
        <p class="rounded-lg border border-dashed border-gray-300 bg-white p-6 text-center text-sm text-gray-500">
          No hay eventos programados por ahora.
        </p>
      <% end %>
    </div>
  </section>

  <section class="space-y-4">
    <div class="flex items-center justify-between gap-3">
      <h3 class="text-base font-semibold text-gray-900">Noticias recientes</h3>
      <%= link_to "Ver todas", news_index_path, class: text_link_class + " text-xs" %>
    </div>

    <div class="space-y-3">
      <% if @news_items.any? %>
        <% @news_items.each do |news_item| %>
          <%= render "news/news_card", news_item: news_item %>
        <% end %>
      <% else %>
        <p class="rounded-lg border border-dashed border-gray-300 bg-white p-6 text-center text-sm text-gray-500">
          Todavía no hay noticias relevantes publicadas.
        </p>
      <% end %>
    </div>
  </section>
</div>
