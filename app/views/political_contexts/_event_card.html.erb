<div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
  <div class="flex items-start gap-3">
    <div class="flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-lg bg-blue-50 text-blue-700">
      <span class="text-xs font-semibold uppercase"><%= event.starts_at.strftime("%b") %></span>
      <span class="text-lg font-bold leading-none"><%= event.starts_at.day %></span>
    </div>

    <div class="min-w-0 flex-1">
      <time datetime="<%= event.starts_at.iso8601 %>" class="text-xs text-gray-400">
        <%= l(event.starts_at, format: :short) %>
      </time>
      <h3 class="mt-1 text-base font-semibold text-gray-900"><%= event.title %></h3>
      <p class="mt-2 line-clamp-2 text-sm text-gray-600"><%= event.description %></p>
      <% if event.location.present? %>
        <p class="mt-2 text-xs text-gray-500"><%= event.location %></p>
      <% end %>
    </div>
  </div>
</div>
