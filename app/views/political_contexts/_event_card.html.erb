<div class="rounded-lg border border-gray-200 bg-white p-4 font-brand shadow-sm">
  <div class="flex items-start gap-3">
    <div class="h-14 w-14 <%= date_badge_class %>">
      <span class="text-xs font-semibold uppercase"><%= event.start_at.strftime("%b") %></span>
      <span class="text-lg font-bold leading-none"><%= event.start_at.day %></span>
    </div>

    <div class="min-w-0 flex-1">
      <%= render "events/event_type_chip", event_type: event.event_type, size: :sm %>
      <time datetime="<%= event.start_at.iso8601 %>" class="mt-2 block <%= card_meta_class %>">
        <%= event.start_at.to_fs(:short) %>
      </time>
      <h3 class="mt-1 <%= card_title_class %>">
        <%= link_to event.title, event_path(event), class: text_link_class + " font-semibold no-underline hover:underline" %>
      </h3>
      <p class="mt-2 line-clamp-2 text-sm text-gray-700"><%= event.description %></p>
      <% if event.location.present? %>
        <p class="mt-2 <%= card_meta_class %>"><%= event.location %></p>
      <% end %>
      <% if event.commune.present? %>
        <p class="mt-1 <%= card_meta_class %>"><%= event.commune.name %></p>
      <% end %>
    </div>
  </div>
</div>
