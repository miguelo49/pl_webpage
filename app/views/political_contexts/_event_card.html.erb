<div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
  <div class="flex items-start gap-3">
    <div class="flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-lg bg-blue-50 text-blue-800">
      <span class="text-xs font-semibold uppercase"><%= event.start_at.strftime("%b") %></span>
      <span class="text-lg font-bold leading-none"><%= event.start_at.day %></span>
    </div>

    <div class="min-w-0 flex-1">
      <time datetime="<%= event.start_at.iso8601 %>" class="text-xs text-gray-500">
        <%= event.start_at.to_fs(:short) %>
      </time>
      <h3 class="mt-1 text-base font-semibold text-gray-900">
        <%= link_to event.title, event_path(event), class: text_link_class + " font-semibold no-underline hover:underline" %>
      </h3>
      <p class="mt-2 line-clamp-2 text-sm text-gray-700"><%= event.description %></p>
      <% if event.location.present? %>
        <p class="mt-2 text-xs text-gray-500"><%= event.location %></p>
      <% end %>
      <% if event.commune.present? %>
        <p class="mt-1 text-xs text-gray-500"><%= event.commune.name %></p>
      <% end %>
    </div>
  </div>
</div>
