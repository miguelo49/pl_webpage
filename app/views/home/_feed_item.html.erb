<div id="feed_item_<%= entry.record_type.downcase %>_<%= entry.record_id %>" class="space-y-2">
  <span class="<%= entry.record_type == "News" ? news_chip_class(size: :sm) : category_chip_class(size: :sm) %>">
    <%= entry.record_type == "News" ? "Noticia" : "Evento" %>
  </span>

  <% if entry.record_type == "News" %>
    <%= render "news/news_card", news_item: entry.record %>
  <% else %>
    <%= render "events/feed_card", event: entry.record %>
  <% end %>
</div>
