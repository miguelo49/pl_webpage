<div class="space-y-6">
  <div>
    <%= link_to "← Volver al hilo", topic_thread_path(@topic, @thread), class: text_link_class %>
    <%= render "shared/page_heading",
          title: "Editar hilo",
          heading_class: "mt-2" %>
  </div>

  <div class="rounded-lg border border-gray-200 bg-white p-4">
    <%= render "threads/form", topic: @topic, thread: @thread, frame_id: "_top" %>
  </div>
</div>
