<% if @thread.pending? && @thread.user_id == current_user.id %>
  <%= turbo_stream.replace "new_thread" do %>
    <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
      Tu hilo fue enviado y está pendiente de aprobación.
    </div>
  <% end %>
<% else %>
  <%= turbo_stream.prepend "threads_list" do %>
    <%= render "threads/thread_card", thread: @thread %>
  <% end %>

  <%= turbo_stream.replace "new_thread" do %>
    <%= turbo_frame_tag "new_thread" %>
  <% end %>
<% end %>

<%= turbo_stream.update "flash_messages" do %>
  <% if @thread.pending? %>
    <p class="<%= flash_warning_class %>">Tu hilo fue creado y está pendiente de aprobación.</p>
  <% else %>
    <p class="<%= flash_notice_class %>">Hilo publicado correctamente.</p>
  <% end %>
<% end %>
