<%= link_to topic_thread_path(topic, thread), class: "block rounded-lg border border-gray-200 bg-white p-4 shadow-sm transition hover:border-blue-200" do %>
  <h3 class="text-base font-semibold text-gray-900"><%= thread.title %></h3>
  <p class="mt-2 line-clamp-2 text-sm text-gray-600"><%= thread.body %></p>
  <div class="mt-3 flex items-center justify-between text-xs text-gray-400">
    <span><%= thread.user.first_name %></span>
    <time datetime="<%= thread.created_at.iso8601 %>"><%= thread.created_at.to_fs(:short) %></time>
  </div>
<% end %>
