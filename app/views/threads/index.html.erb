<div class="space-y-6">
  <div class="flex items-start justify-between gap-3">
    <%= render "shared/page_heading",
          title: "Foro",
          subtitle: "Hilos aprobados de todos los tópicos." %>

    <% if @topics.any? %>
      <% if @topics.one? %>
        <%= link_to "Nuevo hilo",
              new_topic_thread_path(@topics.first),
              class: action_link_class,
              data: { turbo_frame: "new_thread" } %>
      <% else %>
        <details class="relative shrink-0">
          <summary class="<%= action_link_class %> cursor-pointer list-none [&::-webkit-details-marker]:hidden">Nuevo hilo</summary>
          <div class="absolute right-0 z-10 mt-1 min-w-44 rounded-lg border border-gray-200 bg-white py-1 shadow-lg">
            <% @topics.each do |topic| %>
              <%= link_to topic.name,
                    new_topic_thread_path(topic),
                    class: "block px-3 py-2 text-sm text-gray-800 hover:bg-primary/5 hover:text-primary",
                    data: { turbo_frame: "new_thread" } %>
            <% end %>
          </div>
        </details>
      <% end %>
    <% end %>
  </div>

  <%= turbo_frame_tag "new_thread" %>

  <div id="threads_list" class="<%= listing_grid_class %>">
    <% if @threads.any? %>
      <% @threads.each do |thread| %>
        <%= render "threads/thread_card", thread: thread %>
      <% end %>
    <% else %>
      <p class="col-span-full rounded-lg border border-dashed border-gray-300 bg-white p-6 text-center text-sm text-gray-500">
        Todavía no hay hilos aprobados en el foro.
      </p>
    <% end %>
  </div>
</div>
