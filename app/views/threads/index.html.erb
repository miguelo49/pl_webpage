<div class="space-y-6">
  <div class="flex items-start justify-between gap-3">
    <div>
      <%= link_to "← #{@topic.name}", topic_threads_path(@topic), class: text_link_class %>
      <h2 class="mt-2 text-xl font-semibold text-gray-900"><%= @topic.name %></h2>
      <p class="mt-1 text-sm text-gray-500">Hilos aprobados de la comunidad.</p>
    </div>
    <%= link_to "Nuevo hilo",
          new_topic_thread_path(@topic),
          class: action_link_class,
          data: { turbo_frame: "new_thread" } %>
  </div>

  <%= turbo_frame_tag "new_thread" %>

  <div id="threads_list" class="<%= listing_grid_class %>">
    <% if @threads.any? %>
      <% @threads.each do |thread| %>
        <%= render "threads/thread_card", topic: @topic, thread: thread %>
      <% end %>
    <% else %>
      <p class="rounded-lg border border-dashed border-gray-300 bg-white p-6 text-center text-sm text-gray-500">
        Todavía no hay hilos aprobados en este tópico.
      </p>
    <% end %>
  </div>
</div>
