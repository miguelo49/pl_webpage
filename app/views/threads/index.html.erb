<div class="space-y-6">
  <div class="flex items-start justify-between gap-3">
    <%= render "shared/page_heading",
          title: "Foro",
          liberal: true,
          subtitle: "Hilos aprobados de todos los tópicos." %>

    <% if @topics.any? %>
      <% if @topics.one? %>
        <%= link_to "Nuevo hilo",
              new_topic_thread_path(@topics.first),
              class: action_link_class,
              data: { turbo_frame: "new_thread" } %>
      <% else %>
        <details class="relative shrink-0">
          <summary class="<%= action_link_class %> cursor-pointer list-none [&::-webkit-details-marker]:hidden">Nuevo hilo</summary>
          <div class="absolute right-0 z-10 mt-1 min-w-44 rounded-lg border border-gray-200 bg-white py-1 shadow-lg">
            <% @topics.each do |topic| %>
              <%= link_to topic.name,
                    new_topic_thread_path(topic),
                    class: "block px-4 py-2.5 text-sm text-gray-800 hover:bg-primary/5 hover:text-primary",
                    data: { turbo_frame: "new_thread" } %>
            <% end %>
          </div>
        </details>
      <% end %>
    <% end %>
  </div>

  <% if @topics.many? %>
    <div
      class="flex flex-wrap gap-2"
      data-controller="topic-filter"
      data-topic-filter-base-url-value="<%= threads_path %>"
      data-topic-filter-selected-ids-value="<%= @selected_topic_ids.to_json %>"
      data-topic-filter-active-class-value="<%= chip_filter_class(active: true) %>"
      data-topic-filter-inactive-class-value="<%= chip_filter_class(active: false) %>">
      <button
        type="button"
        data-topic-filter-target="chip"
        data-action="topic-filter#selectAll"
        class="<%= chip_filter_class(active: @selected_topic_ids.empty?) %>">
        Todos
      </button>
      <% @topics.each do |topic| %>
        <button
          type="button"
          data-topic-filter-target="chip"
          data-topic-id="<%= topic.id %>"
          data-action="topic-filter#toggle"
          class="<%= chip_filter_class(active: @selected_topic_ids.include?(topic.id)) %>">
          <%= topic.name %>
        </button>
      <% end %>
    </div>
  <% end %>

  <%= turbo_frame_tag "new_thread" %>

  <%= render "threads/threads_content" %>
</div>
