<div class="space-y-6">
  <div>
    <%= link_to "← Foro", threads_path, class: text_link_class %>
    <%= render "shared/page_heading",
          title: @thread.title,
          heading_class: "mt-2" %>
  </div>

  <article class="<%= discussion_post_class %> flex overflow-hidden">
    <div class="shrink-0 border-r border-gray-100 py-3">
      <%= render "reactions/vote",
            reactable: @thread,
            react_path: react_path_for(@thread, topic: @topic, thread: @thread) %>
    </div>

    <div class="min-w-0 flex-1 p-4">
      <%= render "shared/author_meta", user: @thread.user, created_at: @thread.created_at, avatar_size: :md %>

      <div class="prose prose-sm mt-3 max-w-none text-gray-700">
        <%= simple_format(@thread.body) %>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-gray-100 pt-3">
        <%= render "bookmarks/button",
              bookmarkable: @thread,
              bookmark_path: bookmark_path_for(@thread, topic: @topic) %>
        <% if policy(@thread).update? %>
          <%= link_to "Editar", edit_topic_thread_path(@topic, @thread), class: discussion_action_class %>
        <% end %>
      </div>
    </div>
  </article>

  <%= turbo_frame_tag "comments" do %>
    <section class="<%= discussion_section_class %> space-y-4">
      <h3 class="border-b border-gray-200 pb-2 text-base font-semibold text-gray-900">
        Comentarios (<%= @comments.size %>)
      </h3>

      <div id="comment_form">
        <%= render "comments/form", topic: @topic, thread: @thread, comment: @comment %>
      </div>

      <div id="comments_list" class="space-y-3">
        <% if @comments.any? %>
          <% @comments.each do |comment| %>
            <%= render "comments/comment", comment: comment, topic: @topic, thread: @thread %>
          <% end %>
        <% else %>
          <div class="rounded-md border border-dashed border-gray-300 bg-white p-6 text-center">
            <p class="text-sm font-medium text-gray-700">Sé el primero en comentar</p>
            <p class="mt-1 text-xs text-gray-500">Comparte tu opinión sobre este hilo.</p>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
