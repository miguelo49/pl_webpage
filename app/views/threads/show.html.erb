<div class="space-y-6">
  <div>
    <%= link_to "← Foro", threads_path, class: text_link_class %>
    <%= render "shared/page_heading",
          title: @thread.title,
          heading_class: "mt-2" %>
    <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-gray-500">
      <span><%= @thread.user.first_name %></span>
      <span class="rounded-full px-2 py-0.5 font-medium <%= user_role_badge_class(@thread.user.role) %>">
        <%= user_role_label(@thread.user.role) %>
      </span>
      <span>·</span>
      <time datetime="<%= @thread.created_at.iso8601 %>"><%= @thread.created_at.to_fs(:short) %></time>
    </div>
  </div>

  <article class="rounded-lg border border-gray-200 bg-white p-4">
    <div class="prose prose-sm max-w-none text-gray-700">
      <%= simple_format(@thread.body) %>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <%= render "reactions/button",
            reactable: @thread,
            react_path: react_path_for(@thread, topic: @topic, thread: @thread) %>
      <%= render "bookmarks/button",
            bookmarkable: @thread,
            bookmark_path: bookmark_path_for(@thread, topic: @topic) %>
    </div>
  </article>

  <% if policy(@thread).update? %>
    <div>
      <%= link_to "Editar hilo", edit_topic_thread_path(@topic, @thread), class: text_link_class %>
    </div>
  <% end %>

  <%= turbo_frame_tag "comments" do %>
    <section class="space-y-4">
      <h3 class="text-base font-semibold text-gray-900">Comentarios</h3>

      <div id="comments_list" class="space-y-4">
        <% if @comments.any? %>
          <% @comments.each do |comment| %>
            <%= render "comments/comment", comment: comment, topic: @topic, thread: @thread %>
          <% end %>
        <% else %>
          <p class="text-sm text-gray-600">Sé el primero en comentar.</p>
        <% end %>
      </div>

      <div id="comment_form">
        <%= render "comments/form", topic: @topic, thread: @thread, comment: @comment %>
      </div>
    </section>
  <% end %>
</div>
