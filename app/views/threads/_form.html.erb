<%= form_with model: thread,
      url: thread.persisted? ? topic_thread_path(topic, thread) : topic_threads_path(topic),
      html: { data: { turbo_frame: frame_id }, class: "space-y-4" } do |form| %>
  <% if thread.errors.any? %>
    <div class="<%= error_alert_class %>">
      <ul class="list-inside list-disc space-y-1">
        <% thread.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Título", class: filter_label_class.sub("text-xs", "text-sm") %>
    <%= form.text_field :title, class: filter_input_class, autofocus: true %>
  </div>

  <div>
    <%= form.label :body, "Contenido", class: filter_label_class.sub("text-xs", "text-sm") %>
    <%= form.text_area :body, rows: 5, class: filter_input_class %>
  </div>

  <%= form.submit "Publicar hilo", class: primary_button_class %>
<% end %>
