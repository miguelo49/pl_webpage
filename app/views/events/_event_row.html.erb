<%= link_to event_path(event), class: list_card_link_class do %>
  <div class="h-12 w-12 <%= date_badge_class %>">
    <span class="text-[10px] font-semibold uppercase leading-none"><%= event.start_at.strftime("%H:%M") %></span>
  </div>

  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-2 text-[10px] text-gray-400">
      <%= render "events/event_type_chip", event_type: event.event_type, size: :sm %>
      <% if event.commune.present? %>
        <span><%= event.commune.name %></span>
      <% end %>
    </div>
    <h3 class="mt-1 text-sm font-semibold text-gray-900"><%= event.title %></h3>
    <% if event.location.present? %>
      <p class="mt-1 truncate <%= card_meta_class %>"><%= event.location %></p>
    <% end %>
  </div>
<% end %>
