<div class="mx-auto max-w-md space-y-6">
  <%= render "shared/page_heading", title: "Reenviar instrucciones de desbloqueo" %>

  <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= render "devise/shared/form_field",
          form: f,
          field: :email,
          label: "Correo electrónico",
          field_type: :email_field,
          autocomplete: "email",
          html_options: { autofocus: true } %>

    <%= f.submit "Reenviar instrucciones", class: primary_button_class %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
