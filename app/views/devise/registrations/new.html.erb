<div class="space-y-6">
  <div>
    <h2 class="text-xl font-semibold text-gray-900">Crear cuenta</h2>
    <p class="mt-1 text-sm text-gray-500">Create an account to get started.</p>
  </div>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= render "devise/shared/form_field",
          form: f,
          field: :first_name,
          label: "Nombre",
          field_type: :text_field,
          autocomplete: "given-name",
          html_options: { autofocus: true } %>

    <%= render "devise/shared/form_field",
          form: f,
          field: :last_name,
          label: "Apellido",
          field_type: :text_field,
          autocomplete: "family-name" %>

    <%= render "devise/shared/form_field",
          form: f,
          field: :email,
          label: "Correo electrónico",
          field_type: :email_field,
          autocomplete: "email" %>

    <%= render "devise/shared/form_field",
          form: f,
          field: :password,
          label: "Contraseña",
          field_type: :password_field,
          autocomplete: "new-password",
          html_options: {} %>
    <% if @minimum_password_length %>
      <p class="text-xs text-gray-500">Mínimo <%= @minimum_password_length %> caracteres.</p>
    <% end %>

    <%= render "devise/shared/form_field",
          form: f,
          field: :password_confirmation,
          label: "Confirmar contraseña",
          field_type: :password_field,
          autocomplete: "new-password" %>

    <%= f.submit "Registrarse", class: primary_button_class %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
