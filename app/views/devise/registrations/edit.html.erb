<div class="space-y-6">
  <div>
    <h2 class="text-xl font-semibold text-gray-900">Editar cuenta</h2>
  </div>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= render "devise/shared/form_field",
          form: f,
          field: :first_name,
          label: "Nombre",
          field_type: :text_field,
          autocomplete: "given-name" %>

    <%= render "devise/shared/form_field",
          form: f,
          field: :last_name,
          label: "Apellido",
          field_type: :text_field,
          autocomplete: "family-name" %>

    <%= render "devise/shared/form_field",
          form: f,
          field: :email,
          label: "Correo electrónico",
          field_type: :email_field,
          autocomplete: "email" %>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <p class="text-sm text-amber-700">Esperando confirmación de: <%= resource.unconfirmed_email %></p>
    <% end %>

    <%= render "devise/shared/form_field",
          form: f,
          field: :password,
          label: "Nueva contraseña (opcional)",
          field_type: :password_field,
          autocomplete: "new-password" %>
    <% if @minimum_password_length %>
      <p class="text-xs text-gray-500">Mínimo <%= @minimum_password_length %> caracteres.</p>
    <% end %>

    <%= render "devise/shared/form_field",
          form: f,
          field: :password_confirmation,
          label: "Confirmar nueva contraseña",
          field_type: :password_field,
          autocomplete: "new-password" %>

    <%= render "devise/shared/form_field",
          form: f,
          field: :current_password,
          label: "Contraseña actual",
          field_type: :password_field,
          autocomplete: "current-password" %>

    <%= f.submit "Actualizar",
          class: "w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
  <% end %>

  <div class="border-t border-gray-200 pt-4">
    <h3 class="text-sm font-medium text-gray-900">Cancelar cuenta</h3>
    <p class="mt-1 text-sm text-gray-500">Esta acción no se puede deshacer.</p>
    <%= button_to "Eliminar cuenta",
          registration_path(resource_name),
          method: :delete,
          data: { turbo_confirm: "¿Estás seguro?" },
          class: "mt-3 w-full rounded-lg border border-red-300 bg-white px-4 py-2.5 text-sm font-semibold text-red-700 hover:bg-red-50" %>
  </div>

  <%= render "devise/shared/links" %>
</div>
