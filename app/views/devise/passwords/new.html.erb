<div class="space-y-6">
  <div>
    <h2 class="text-xl font-semibold text-gray-900">Recuperar contraseña</h2>
    <p class="mt-1 text-sm text-gray-500">Te enviaremos instrucciones a tu correo.</p>
  </div>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= render "devise/shared/form_field",
          form: f,
          field: :email,
          label: "Correo electrónico",
          field_type: :email_field,
          autocomplete: "email",
          html_options: { autofocus: true } %>

    <%= f.submit "Enviar instrucciones", class: primary_button_class %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
