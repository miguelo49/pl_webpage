<div class="space-y-6">
  <div>
    <h2 class="text-xl font-semibold text-gray-900">Nueva contraseña</h2>
    <p class="mt-1 text-sm text-gray-500">Elige una contraseña segura.</p>
  </div>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <%= render "devise/shared/form_field",
          form: f,
          field: :password,
          label: "Nueva contraseña",
          field_type: :password_field,
          autocomplete: "new-password",
          html_options: { autofocus: true } %>
    <% if @minimum_password_length %>
      <p class="text-xs text-gray-500">Mínimo <%= @minimum_password_length %> caracteres.</p>
    <% end %>

    <%= render "devise/shared/form_field",
          form: f,
          field: :password_confirmation,
          label: "Confirmar contraseña",
          field_type: :password_field,
          autocomplete: "new-password" %>

    <%= f.submit "Cambiar contraseña",
          class: "w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
