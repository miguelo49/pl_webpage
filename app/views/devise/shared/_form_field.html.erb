<% label_class = form_label_class %>
<% html_options = local_assigns.fetch(:html_options, {}) %>

<div class="space-y-4">
  <div>
    <%= form.label field, label, class: label_class %>
    <%= form.public_send(field_type, field, { class: filter_input_class, autocomplete: autocomplete }.merge(html_options)) %>
  </div>
</div>
