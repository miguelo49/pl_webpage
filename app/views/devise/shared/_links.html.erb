<div class="mt-6 space-y-2 text-center text-sm">
  <% if controller_name != "sessions" %>
    <%= link_to "Iniciar sesión", new_session_path(resource_name), class: text_link_class + " block justify-center" %>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != "registrations" %>
    <%= link_to "Registrarse", new_registration_path(resource_name), class: text_link_class + " block justify-center" %>
  <% end %>

  <% if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name), class: text_link_class + " block justify-center" %>
  <% end %>
</div>
