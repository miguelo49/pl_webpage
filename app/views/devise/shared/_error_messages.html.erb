<% if resource.errors.any? %>
  <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" data-turbo-temporary>
    <p class="font-medium">
      <%= pluralize(resource.errors.count, "error") %> impidieron guardar los cambios:
    </p>
    <ul class="mt-2 list-inside list-disc space-y-1">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
