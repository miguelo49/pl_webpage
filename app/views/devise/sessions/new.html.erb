<div class="space-y-6">
  <div>
    <h2 class="text-xl font-semibold text-gray-900">Iniciar sesión</h2>
    <p class="mt-1 text-sm text-gray-500">Accede con tu correo y contraseña.</p>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/form_field",
          form: f,
          field: :email,
          label: "Correo electrónico",
          field_type: :email_field,
          autocomplete: "email",
          html_options: { autofocus: true } %>

    <%= render "devise/shared/form_field",
          form: f,
          field: :password,
          label: "Contraseña",
          field_type: :password_field,
          autocomplete: "current-password" %>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-gray-300 text-blue-700 focus:ring-2 focus:ring-blue-700" %>
        <%= f.label :remember_me, "Recordarme", class: "text-sm text-gray-700" %>
      </div>
    <% end %>

    <%= f.submit "Iniciar sesión", class: primary_button_class %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
