<div class="space-y-6">
  <div>
    <h2 class="text-xl font-semibold text-gray-900">Biblioteca</h2>
    <p class="mt-1 text-sm text-gray-500">Material de formación en PDF.</p>
  </div>

  <div class="sticky top-14 z-[5] -mx-4 space-y-3 border-b border-gray-200 bg-gray-50/95 px-4 pb-4 backdrop-blur">
    <%= form_with url: training_materials_path, method: :get, html: { class: "space-y-3" } do |form| %>
      <div>
        <%= form.label :q, "Buscar", class: "sr-only" %>
        <%= form.search_field :q,
              value: @query,
              placeholder: "Buscar por título o tag...",
              class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" %>
      </div>

      <div>
        <%= form.label :training_category_id, "Categoría", class: "mb-1 block text-xs font-medium text-gray-600" %>
        <%= form.select :training_category_id,
              options_from_collection_for_select(@training_categories, :id, :name, @selected_category_id),
              { include_blank: "Todas las categorías" },
              class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500",
              onchange: "this.form.requestSubmit()" %>
      </div>

      <%= form.submit "Buscar",
            class: "w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700" %>
    <% end %>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <% if @training_materials.any? %>
      <% @training_materials.each do |training_material| %>
        <%= render "training_materials/material_card", training_material: training_material %>
      <% end %>
    <% else %>
      <p class="col-span-2 rounded-lg border border-dashed border-gray-300 bg-white p-6 text-center text-sm text-gray-500">
        No se encontró material con esos criterios.
      </p>
    <% end %>
  </div>
</div>
