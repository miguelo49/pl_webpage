<div id="<%= dom_id(training_material) %>" class="flex flex-col overflow-hidden rounded-lg border border-gray-200 bg-white font-brand shadow-sm">
  <div class="aspect-[3/4] w-full bg-gray-100">
    <% if training_material.cover_image.attached? %>
      <%= image_tag training_material.cover_image.variant(resize_to_fill: [ 400, 520 ]),
            class: "h-full w-full object-cover",
            alt: "" %>
    <% else %>
      <div class="flex h-full items-center justify-center px-3 text-center text-xs text-gray-400">
        Sin portada
      </div>
    <% end %>
  </div>

  <div class="flex flex-1 flex-col p-3">
    <span class="<%= card_meta_class %>"><%= training_material.training_category.name %></span>
    <%= link_to training_material_path(training_material), class: "mt-1 block rounded #{focus_ring_class}" do %>
      <h3 class="line-clamp-2 text-sm font-semibold text-gray-900 hover:text-primary"><%= training_material.title %></h3>
    <% end %>
    <p class="mt-1 <%= card_meta_class %>"><%= training_material.author %></p>

    <% if training_material.tags.any? %>
      <div class="mt-2 flex flex-wrap gap-1">
        <% training_material.tags.first(3).each do |tag| %>
          <span class="rounded-full bg-gray-100 px-2 py-0.5 text-[10px] text-gray-600"><%= tag %></span>
        <% end %>
      </div>
    <% end %>

    <div class="mt-3 flex flex-wrap gap-2">
      <%= render "bookmarks/button",
            bookmarkable: training_material,
            bookmark_path: bookmark_path_for(training_material) %>
      <%= render "training_materials/read_mark_button", training_material: training_material %>
    </div>
  </div>
</div>
