<div class="space-y-6">
  <%= link_to "← Biblioteca", training_materials_path, class: text_link_class %>

  <div>
    <span class="text-xs text-gray-500"><%= @training_material.training_category.name %></span>
    <%= render "shared/page_heading",
          title: @training_material.title,
          heading_class: "mt-1" %>
    <p class="mt-2 text-sm text-gray-700"><%= @training_material.author %></p>
    <time datetime="<%= @training_material.date.iso8601 %>" class="mt-1 block text-xs text-gray-500">
      <%= @training_material.date.to_fs(:long) %>
    </time>
  </div>

  <% if @training_material.tags.any? %>
    <div class="flex flex-wrap gap-1">
      <% @training_material.tags.each do |tag| %>
        <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-700"><%= tag %></span>
      <% end %>
    </div>
  <% end %>

  <p class="text-sm text-gray-700"><%= @training_material.description %></p>

  <div class="flex flex-wrap gap-2">
    <%= render "bookmarks/button",
          bookmarkable: @training_material,
          bookmark_path: bookmark_path_for(@training_material) %>
    <%= render "training_materials/read_mark_button", training_material: @training_material %>
  </div>

  <% if @training_material.pdf.attached? %>
    <section class="space-y-4">
      <div class="grid gap-2 sm:grid-cols-2">
        <%= link_to "Descargar PDF",
              download_training_material_path(@training_material),
              class: primary_button_class(full_width: false) + " px-4 py-3" %>

        <%= link_to "Abrir PDF",
              rails_blob_path(@training_material.pdf, disposition: :inline),
              target: "_blank",
              rel: "noopener noreferrer",
              class: secondary_button_class(full_width: false) + " px-4 py-3 md:hidden" %>
      </div>

      <p class="text-sm text-gray-600 md:hidden">
        En móvil, descarga o abre el PDF en tu app nativa para una mejor experiencia.
      </p>

      <div class="hidden overflow-hidden rounded-lg border border-gray-200 bg-white md:block">
        <iframe
          src="<%= rails_blob_path(@training_material.pdf, disposition: :inline) %>"
          title="<%= @training_material.title %> PDF"
          class="h-[70vh] w-full"
          loading="lazy"
        ></iframe>
      </div>
    </section>
  <% else %>
    <p class="rounded-lg border border-dashed border-gray-300 bg-white p-6 text-center text-sm text-gray-600">
      Este material todavía no tiene un PDF disponible.
    </p>
  <% end %>
</div>
