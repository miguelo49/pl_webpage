<%= turbo_frame_tag dom_id(training_material, :read_mark) do %>
  <%= button_to read_mark_training_material_path(training_material),
        method: :post,
        class: "inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium transition #{read_by_current_user?(training_material) ? 'border-green-200 bg-green-50 text-green-800' : 'border-gray-200 bg-white text-gray-600 hover:border-green-200 hover:text-green-800'}",
        form: { data: { turbo_stream: true } } do %>
    <span><%= read_by_current_user?(training_material) ? "Leído" : "Marcar como leído" %></span>
  <% end %>
<% end %>
