<% saved = bookmarked_by_current_user?(bookmarkable) %>
<%= turbo_frame_tag dom_id(bookmarkable, :bookmark) do %>
  <%= button_to bookmark_path,
        method: :post,
        class: "inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium transition #{saved ? 'border-amber-200 bg-amber-50 text-amber-800' : 'border-gray-200 bg-white text-gray-600 hover:border-amber-200 hover:text-amber-800'}",
        form: { data: { turbo_stream: true } } do %>
    <span><%= saved ? "Guardado" : "Guardar" %></span>
  <% end %>
<% end %>
