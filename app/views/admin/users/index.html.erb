<div class="space-y-6">
  <div>
    <h2 class="text-xl font-semibold text-gray-900">Usuarios</h2>
    <p class="mt-1 text-sm text-gray-500">Edita rol y estado activo.</p>
  </div>

  <%= render "admin/shared/nav" %>

  <div class="space-y-2">
    <% @users.each do |user| %>
      <%= link_to edit_admin_user_path(user), class: "flex items-center justify-between gap-3 rounded-lg border border-gray-200 bg-white p-4 hover:border-blue-200" do %>
        <div>
          <p class="font-medium text-gray-900"><%= user.full_name %></p>
          <p class="text-sm text-gray-500"><%= user.email %></p>
        </div>
        <div class="text-right text-xs">
          <span class="rounded-full bg-gray-100 px-2 py-0.5 font-medium text-gray-700"><%= user_role_label(user.role) %></span>
          <p class="mt-1 <%= user.active? ? 'text-green-600' : 'text-red-600' %>"><%= user.active? ? "Activo" : "Inactivo" %></p>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
