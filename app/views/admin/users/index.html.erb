<div class="space-y-6">
  <div>
    <h2 class="text-xl font-semibold text-gray-900">Usuarios</h2>
    <p class="mt-1 text-sm text-gray-500">Edita rol y estado activo.</p>
  </div>

  <%= render "admin/shared/nav" %>

  <%= render "shared/user_directory_search", search_path: admin_users_path %>

  <div class="space-y-2">
    <% @users.each do |user| %>
      <%= link_to edit_admin_user_path(user), class: card_link_class + " flex items-center justify-between gap-3" do %>
        <div>
          <p class="font-medium text-gray-900"><%= user.full_name %></p>
          <p class="text-sm text-gray-500"><%= user.email %></p>
          <% if user.display_rut.present? %>
            <p class="text-xs text-gray-400">RUT <%= user.display_rut %></p>
          <% end %>
        </div>
        <div class="text-right text-xs">
          <span class="rounded-full px-2 py-0.5 font-medium <%= user_role_badge_class(user.role) %>">
            <%= user_role_label(user.role) %>
          </span>
          <p class="mt-1 <%= user.active? ? 'text-green-800' : 'text-red-800' %>"><%= user.active? ? "Activo" : "Inactivo" %></p>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
