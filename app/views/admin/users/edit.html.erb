<div class="space-y-6">
  <%= link_to "← Usuarios", admin_users_path, class: "text-sm text-blue-600 hover:text-blue-800" %>

  <div>
    <h2 class="text-xl font-semibold text-gray-900"><%= @user.full_name %></h2>
    <p class="text-sm text-gray-500"><%= @user.email %></p>
  </div>

  <%= render "admin/shared/nav" %>

  <%= form_with model: @user, url: admin_user_path(@user), method: :patch, html: { class: "space-y-4 rounded-lg border border-gray-200 bg-white p-4" } do |form| %>
    <% if @user.errors.any? %>
      <div class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800">
        <%= @user.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= form.label :role, "Rol", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= form.select :role,
            User.roles.keys.map { |role| [ user_role_label(role), role ] },
            {},
            class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm" %>
    </div>

    <div class="flex items-center gap-2">
      <%= form.check_box :active, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
      <%= form.label :active, "Cuenta activa", class: "text-sm text-gray-700" %>
    </div>

    <%= form.submit "Guardar cambios", class: "w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700" %>
  <% end %>
</div>
