<div class="space-y-6">
  <%= link_to "← Usuarios", admin_users_path, class: text_link_class %>

  <div>
    <h2 class="text-xl font-semibold text-gray-900"><%= @user.full_name %></h2>
    <p class="text-sm text-gray-600"><%= @user.email %></p>
  </div>

  <%= render "admin/shared/nav" %>

  <%= form_with model: @user, url: admin_user_path(@user), method: :patch, html: { class: "space-y-4 rounded-lg border border-gray-200 bg-white p-4" } do |form| %>
    <% if @user.errors.any? %>
      <div class="<%= error_alert_class %> px-3 py-2">
        <%= @user.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= form.label :role, "Rol", class: filter_label_class.sub("text-xs", "text-sm") %>
      <%= form.select :role,
            User.roles.keys.map { |role| [ user_role_label(role), role ] },
            {},
            class: filter_input_class %>
    </div>

    <div class="flex items-center gap-2">
      <%= form.check_box :active, class: "h-4 w-4 rounded border-gray-300 text-blue-700 focus:ring-2 focus:ring-blue-700" %>
      <%= form.label :active, "Cuenta activa", class: "text-sm text-gray-700" %>
    </div>

    <%= form.submit "Guardar cambios", class: primary_button_class %>
  <% end %>
</div>
