<%= form_with model: [:admin, topic], html: { class: "space-y-4 rounded-lg border border-gray-200 bg-white p-4" } do |form| %>
  <div>
    <%= form.label :name, "Nombre", class: filter_label_class.sub("text-xs", "text-sm") %>
    <%= form.text_field :name, class: filter_input_class, required: true %>
  </div>
  <div>
    <%= form.label :slug, "Slug", class: filter_label_class.sub("text-xs", "text-sm") %>
    <%= form.text_field :slug, class: filter_input_class, required: true %>
  </div>
  <div>
    <%= form.label :description, "Descripción", class: filter_label_class.sub("text-xs", "text-sm") %>
    <%= form.text_area :description, rows: 3, class: filter_input_class %>
  </div>
  <div>
    <%= form.label :position, "Posición", class: filter_label_class.sub("text-xs", "text-sm") %>
    <%= form.number_field :position, class: filter_input_class, required: true %>
  </div>
  <%= form.submit topic.persisted? ? "Actualizar" : "Crear", class: primary_button_class %>
<% end %>
