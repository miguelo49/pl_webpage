<% input_class = "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm" %>

<%= form_with model: [:admin, topic], html: { class: "space-y-4 rounded-lg border border-gray-200 bg-white p-4" } do |form| %>
  <div>
    <%= form.label :name, "Nombre", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, class: input_class, required: true %>
  </div>
  <div>
    <%= form.label :slug, "Slug", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= form.text_field :slug, class: input_class, required: true %>
  </div>
  <div>
    <%= form.label :description, "Descripción", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= form.text_area :description, rows: 3, class: input_class %>
  </div>
  <div>
    <%= form.label :position, "Posición", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= form.number_field :position, class: input_class, required: true %>
  </div>
  <%= form.submit topic.persisted? ? "Actualizar" : "Crear", class: "w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white" %>
<% end %>
