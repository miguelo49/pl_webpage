<div class="space-y-6">
  <div>
    <h2 class="text-xl font-semibold text-gray-900">Administración técnica</h2>
    <p class="mt-1 text-sm text-gray-500">Gestión de usuarios, territorios y catálogos.</p>
  </div>

  <%= render "admin/shared/nav" %>

  <div class="grid gap-3 sm:grid-cols-2">
    <%= link_to admin_users_path, class: card_link_class do %>
      <h3 class="font-semibold text-gray-900">Usuarios</h3>
      <p class="mt-1 text-sm text-gray-500">Roles y activación de cuentas</p>
    <% end %>
    <%= link_to admin_regions_path, class: card_link_class do %>
      <h3 class="font-semibold text-gray-900">Regiones y comunas</h3>
      <p class="mt-1 text-sm text-gray-500">Territorios de la organización</p>
    <% end %>
    <%= link_to admin_topics_path, class: card_link_class do %>
      <h3 class="font-semibold text-gray-900">Tópicos del foro</h3>
      <p class="mt-1 text-sm text-gray-500">Secciones de comunidad</p>
    <% end %>
    <%= link_to admin_training_categories_path, class: card_link_class do %>
      <h3 class="font-semibold text-gray-900">Categorías de biblioteca</h3>
      <p class="mt-1 text-sm text-gray-500">Material de formación</p>
    <% end %>
  </div>
</div>
