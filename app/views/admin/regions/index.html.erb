<% input_class = "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm" %>

<div class="space-y-6">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h2 class="text-xl font-semibold text-gray-900">Regiones</h2>
      <p class="mt-1 text-sm text-gray-500">Catálogo de regiones.</p>
    </div>
    <%= link_to "Nueva región", new_admin_region_path, class: "rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white" %>
  </div>

  <%= render "admin/shared/nav" %>

  <div class="space-y-2">
    <% @regions.each do |region| %>
      <div class="flex items-center justify-between gap-3 rounded-lg border border-gray-200 bg-white p-4">
        <span class="font-medium text-gray-900"><%= region.name %></span>
        <div class="flex gap-2 text-sm">
          <%= link_to "Editar", edit_admin_region_path(region), class: "text-blue-600" %>
          <%= button_to "Eliminar", admin_region_path(region), method: :delete, form: { data: { turbo_confirm: "¿Eliminar región?" } }, class: "text-red-600" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
