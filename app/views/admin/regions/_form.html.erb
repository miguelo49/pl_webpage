<%= form_with model: [:admin, region], html: { class: "space-y-4 rounded-lg border border-gray-200 bg-white p-4" } do |form| %>
  <div>
    <%= form.label :name, "Nombre", class: filter_label_class.sub("text-xs", "text-sm") %>
    <%= form.text_field :name, class: filter_input_class, required: true %>
  </div>
  <%= form.submit region.persisted? ? "Actualizar" : "Crear", class: primary_button_class %>
<% end %>
