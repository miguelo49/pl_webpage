<%= form_with model: [:admin, training_category], html: { class: "space-y-4 rounded-lg border border-gray-200 bg-white p-4" } do |form| %>
  <div>
    <%= form.label :name, "Nombre", class: form_label_class %>
    <%= form.text_field :name, class: filter_input_class, required: true %>
  </div>
  <%= form.submit training_category.persisted? ? "Actualizar" : "Crear", class: primary_button_class %>
<% end %>
