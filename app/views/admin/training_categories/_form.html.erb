<% input_class = "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm" %>

<%= form_with model: [:admin, training_category], html: { class: "space-y-4 rounded-lg border border-gray-200 bg-white p-4" } do |form| %>
  <div>
    <%= form.label :name, "Nombre", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, class: input_class, required: true %>
  </div>
  <%= form.submit training_category.persisted? ? "Actualizar" : "Crear", class: "w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white" %>
<% end %>
