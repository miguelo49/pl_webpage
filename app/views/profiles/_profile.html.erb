<%# locals: (user:, regions:) %>
<%= form_with model: user,
      url: profile_path,
      method: :patch,
      html: { multipart: true, data: { turbo_frame: "profile" }, class: "space-y-6" } do |form| %>

  <%= render "profiles/avatar_section", user: user, form: form %>

  <div class="rounded-lg border border-gray-200 bg-white p-4 space-y-4">
    <h3 class="text-sm font-medium text-gray-900">Datos personales</h3>

    <% if user.errors.any? %>
      <div class="<%= error_alert_class %>">
        <ul class="list-inside list-disc space-y-1">
          <% user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :first_name, "Nombre", class: filter_label_class.sub("text-xs", "text-sm") %>
      <%= form.text_field :first_name, autocomplete: "given-name", class: filter_input_class %>
    </div>

    <div>
      <%= form.label :last_name, "Apellido", class: filter_label_class.sub("text-xs", "text-sm") %>
      <%= form.text_field :last_name, autocomplete: "family-name", class: filter_input_class %>
    </div>

    <p class="text-sm text-gray-600"><%= user.email %></p>
  </div>

  <%= render "shared/commune_fields", form: form, regions: regions %>

  <%= form.submit "Guardar cambios", class: primary_button_class %>
<% end %>
