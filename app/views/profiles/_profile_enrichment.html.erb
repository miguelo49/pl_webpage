<% if user.profile_enrichment_missing? %>
  <section class="rounded-lg border border-amber-200 bg-amber-50 p-4 space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h3 class="text-sm font-semibold text-amber-900">Completa tu perfil</h3>
      <span class="text-xs font-medium text-amber-800"><%= user.profile_enrichment_percent %>%</span>
    </div>
    <p class="text-sm text-amber-900/90">
      Agrega tu profesión y las comunas donde vives, trabajas o estudias para personalizar tu experiencia.
    </p>
    <div class="h-2 overflow-hidden rounded-full bg-amber-100">
      <div class="h-full rounded-full bg-amber-500 transition-all" style="width: <%= user.profile_enrichment_percent %>%"></div>
    </div>
  </section>
<% end %>
