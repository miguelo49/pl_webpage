<% if technical_admin_panel? || staff_moderation_panel? %>
  <section class="space-y-3 rounded-lg border border-gray-200 bg-white p-4">
    <h3 class="text-sm font-medium text-gray-900">Gestión del sitio</h3>
    <p class="text-sm text-gray-600">
      Tu rol actual:
      <span class="rounded-full px-2 py-0.5 text-xs font-medium <%= user_role_badge_class(current_user.role) %>">
        <%= user_role_label(current_user.role) %>
      </span>
    </p>

    <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap">
      <% if technical_admin_panel? %>
        <%= link_to "Administración técnica", admin_root_path, class: secondary_button_class %>
      <% end %>

      <% if staff_moderation_panel? %>
        <%= link_to "Panel de moderación", moderation_root_path, class: secondary_button_class %>
      <% end %>
    </div>
  </section>
<% end %>
