<div class="space-y-6">
  <%= render "shared/page_heading",
        title: "Mi perfil",
        liberal: true,
        subtitle: "Consulta y edita tus datos básicos." %>

  <%= render "profiles/staff_tools" %>

  <%= render "profiles/profile_enrichment", user: current_user %>

  <%= turbo_frame_tag "profile" do %>
    <%= render "profiles/profile", user: @user, regions: @regions %>
  <% end %>

  <%= render "profiles/saved_threads", bookmarked_threads: @bookmarked_threads %>
</div>
