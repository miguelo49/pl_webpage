<%= turbo_frame_tag dom_id(event, :attendance) do %>
  <section class="rounded-lg border border-gray-200 bg-white p-4 space-y-3">
    <div id="<%= dom_id(event, :capacity) %>" class="text-sm text-gray-600">
      <%= capacity_label_for(event) %>
    </div>

    <% if attendance&.persisted? && attendance.registered? %>
      <p class="text-sm font-medium text-blue-700">Estás inscrito en este evento.</p>
      <div class="flex flex-wrap gap-2">
        <%= button_to "Confirmar asistencia",
              event_attendance_path(event),
              method: :patch,
              params: { attendance: { status: :confirmed } },
              class: "inline-flex items-center rounded-lg bg-blue-600 px-3 py-2 text-xs font-semibold text-white hover:bg-blue-700",
              form: { data: { turbo_stream: true } } %>
        <%= button_to "Cancelar inscripción",
              event_attendance_path(event),
              method: :patch,
              params: { attendance: { status: :cancelled } },
              class: "inline-flex items-center rounded-lg border border-gray-200 bg-white px-3 py-2 text-xs font-semibold text-gray-700 hover:border-red-200 hover:text-red-700",
              form: { data: { turbo_stream: true } } %>
      </div>
    <% elsif attendance&.persisted? && attendance.confirmed? %>
      <p class="text-sm font-medium text-green-700">Tu asistencia está confirmada.</p>
      <%= button_to "Cancelar inscripción",
            event_attendance_path(event),
            method: :patch,
            params: { attendance: { status: :cancelled } },
            class: "inline-flex items-center rounded-lg border border-gray-200 bg-white px-3 py-2 text-xs font-semibold text-gray-700 hover:border-red-200 hover:text-red-700",
            form: { data: { turbo_stream: true } } %>
    <% else %>
      <% if event.full? %>
        <p class="text-sm text-amber-700">Este evento ya no tiene cupos disponibles.</p>
        <%= button_to "Inscribirme",
              event_attendance_path(event),
              method: :post,
              disabled: true,
              class: "inline-flex w-full items-center justify-center rounded-lg bg-gray-200 px-4 py-2.5 text-sm font-semibold text-gray-500" %>
      <% else %>
        <%= button_to "Inscribirme",
              event_attendance_path(event),
              method: :post,
              class: "inline-flex w-full items-center justify-center rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700",
              form: { data: { turbo_stream: true } } %>
      <% end %>

      <% if attendance&.persisted? && attendance.cancelled? %>
        <p class="text-xs text-gray-500">Tu inscripción anterior fue cancelada.</p>
      <% end %>

      <% if attendance&.errors&.any? %>
        <p class="text-sm text-red-700"><%= attendance.errors.full_messages.to_sentence %></p>
      <% end %>
    <% end %>
  </section>
<% end %>
