<%= turbo_frame_tag dom_id(event, :attendance) do %>
  <section class="rounded-lg border border-gray-200 bg-white p-4 space-y-3">
    <div id="<%= dom_id(event, :capacity) %>" class="text-sm text-gray-700">
      <%= capacity_label_for(event) %>
    </div>

    <% if attendance&.persisted? && attendance.registered? %>
      <p class="font-brand text-sm font-medium text-accent">Estás inscrito en este evento.</p>
      <div class="flex flex-wrap gap-2">
        <%= button_to "Confirmar asistencia",
              event_attendance_path(event),
              method: :patch,
              params: { attendance: { status: :confirmed } },
              class: action_link_class,
              form: { data: { turbo_stream: true } } %>
        <%= button_to "Cancelar inscripción",
              event_attendance_path(event),
              method: :patch,
              params: { attendance: { status: :cancelled } },
              class: danger_button_class,
              form: { data: { turbo_stream: true } } %>
      </div>
    <% elsif attendance&.persisted? && attendance.confirmed? %>
      <p class="text-sm font-medium text-green-800">Tu asistencia está confirmada.</p>
      <%= button_to "Cancelar inscripción",
            event_attendance_path(event),
            method: :patch,
            params: { attendance: { status: :cancelled } },
            class: danger_button_class,
            form: { data: { turbo_stream: true } } %>
    <% else %>
      <% if event.full? %>
        <p class="text-sm text-amber-800">Este evento ya no tiene cupos disponibles.</p>
        <%= button_to "Inscribirme",
              event_attendance_path(event),
              method: :post,
              disabled: true,
              class: disabled_button_class %>
      <% else %>
        <%= button_to "Inscribirme",
              event_attendance_path(event),
              method: :post,
              class: primary_button_class,
              form: { data: { turbo_stream: true } } %>
      <% end %>

      <% if attendance&.persisted? && attendance.cancelled? %>
        <p class="text-xs text-gray-600">Tu inscripción anterior fue cancelada.</p>
      <% end %>

      <% if attendance&.errors&.any? %>
        <p class="text-sm text-red-800"><%= attendance.errors.full_messages.to_sentence %></p>
      <% end %>
    <% end %>
  </section>
<% end %>
