<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Pl Webpage" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh bg-gray-50 text-gray-900 antialiased">
    <div class="mx-auto flex min-h-dvh w-full max-w-lg flex-col">
      <header class="sticky top-0 z-10 border-b border-gray-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80">
        <div class="flex h-14 items-center justify-between gap-3 px-4">
          <%= link_to root_path, class: "text-base font-semibold tracking-tight" do %>
            Pl Webpage
          <% end %>

          <div class="flex items-center gap-2 text-sm">
            <% if user_signed_in? %>
              <span class="hidden truncate text-gray-600 sm:inline"><%= current_user.first_name %></span>
              <%= button_to "Salir",
                    destroy_user_session_path,
                    method: :delete,
                    class: "rounded-lg px-2 py-1 text-blue-600 hover:bg-blue-50 hover:text-blue-800" %>
            <% else %>
              <%= link_to "Entrar", new_user_session_path, class: "rounded-lg px-2 py-1 text-blue-600 hover:bg-blue-50 hover:text-blue-800" %>
              <%= link_to "Registro", new_user_registration_path, class: "rounded-lg bg-blue-600 px-2 py-1 font-medium text-white hover:bg-blue-700" %>
            <% end %>
          </div>
        </div>
      </header>

      <% if notice.present? || alert.present? %>
        <div class="space-y-2 px-4 pt-3">
          <% if notice.present? %>
            <p class="rounded-lg border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800"><%= notice %></p>
          <% end %>
          <% if alert.present? %>
            <p class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800"><%= alert %></p>
          <% end %>
        </div>
      <% end %>

      <main class="flex-1 px-4 py-4">
        <%= yield %>
      </main>

      <nav
        class="sticky bottom-0 z-10 border-t border-gray-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80"
        aria-label="Navegación principal"
      >
        <div class="flex h-16 items-center justify-around px-4 text-xs text-gray-400">
          <%= link_to root_path, class: "flex flex-col items-center gap-1 hover:text-gray-600" do %>
            <span class="h-5 w-5 rounded bg-gray-200" aria-hidden="true"></span>
            Inicio
          <% end %>
          <% if user_signed_in? %>
            <%= link_to edit_user_registration_path, class: "flex flex-col items-center gap-1 hover:text-gray-600" do %>
              <span class="h-5 w-5 rounded bg-gray-200" aria-hidden="true"></span>
              Cuenta
            <% end %>
          <% else %>
            <%= link_to new_user_session_path, class: "flex flex-col items-center gap-1 hover:text-gray-600" do %>
              <span class="h-5 w-5 rounded bg-gray-200" aria-hidden="true"></span>
              Entrar
            <% end %>
          <% end %>
          <span class="flex flex-col items-center gap-1">
            <span class="h-5 w-5 rounded bg-gray-200" aria-hidden="true"></span>
            Más
          </span>
        </div>
      </nav>
    </div>
  </body>
</html>
