<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Pl Webpage" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh bg-gray-50 text-gray-900 antialiased">
    <div class="mx-auto flex min-h-dvh w-full max-w-lg flex-col">
      <header class="sticky top-0 z-10 border-b border-gray-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80">
        <div class="flex h-14 items-center px-4">
          <h1 class="text-base font-semibold tracking-tight">Pl Webpage</h1>
        </div>
      </header>

      <main class="flex-1 px-4 py-4">
        <%= yield %>
      </main>

      <nav
        class="sticky bottom-0 z-10 border-t border-gray-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80"
        aria-label="Navegación principal"
      >
        <div class="flex h-16 items-center justify-around px-4 text-xs text-gray-400">
          <span class="flex flex-col items-center gap-1">
            <span class="h-5 w-5 rounded bg-gray-200" aria-hidden="true"></span>
            Inicio
          </span>
          <span class="flex flex-col items-center gap-1">
            <span class="h-5 w-5 rounded bg-gray-200" aria-hidden="true"></span>
            Nav
          </span>
          <span class="flex flex-col items-center gap-1">
            <span class="h-5 w-5 rounded bg-gray-200" aria-hidden="true"></span>
            Más
          </span>
        </div>
      </nav>
    </div>
  </body>
</html>
