<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Pl Webpage" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh bg-gray-50 text-gray-900 antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-3 focus:py-2 focus:text-sm focus:font-medium focus:text-blue-800 focus:shadow">
      Saltar al contenido
    </a>

    <div class="mx-auto flex min-h-dvh w-full max-w-lg flex-col">
      <header class="sticky top-0 z-30 border-b border-gray-300 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/90">
        <div class="flex h-14 items-center justify-between gap-3 px-4">
          <%= link_to root_path, class: "touch-target inline-flex items-center rounded-lg px-2 text-base font-semibold tracking-tight text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700" do %>
            Pl Webpage
          <% end %>

          <div class="flex items-center gap-1 text-sm">
            <% if user_signed_in? %>
              <span id="header_user_name" class="hidden truncate text-gray-700 sm:inline"><%= current_user.first_name %></span>
              <%= button_to "Salir",
                    destroy_user_session_path,
                    method: :delete,
                    class: header_action_class %>
            <% else %>
              <%= link_to "Entrar", new_user_session_path, class: header_action_class %>
              <%= link_to "Registro", new_user_registration_path, class: header_primary_action_class %>
            <% end %>
          </div>
        </div>
      </header>

      <div id="flash_messages" class="space-y-2 px-4 pt-3" role="status" aria-live="polite">
        <% if notice.present? %>
          <p class="rounded-lg border border-green-300 bg-green-50 px-3 py-2 text-sm text-green-900"><%= notice %></p>
        <% end %>
        <% if alert.present? %>
          <p class="rounded-lg border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-900"><%= alert %></p>
        <% end %>
      </div>

      <main id="main-content" class="flex-1 px-4 py-4 <%= 'app-main-with-bottom-nav' unless hide_bottom_nav? %>">
        <%= yield %>
      </main>

      <%= render "shared/bottom_nav" unless hide_bottom_nav? %>
    </div>
  </body>
</html>
