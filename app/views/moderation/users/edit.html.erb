<div class="space-y-6">
  <%= link_to "← Usuarios", moderation_users_path, class: text_link_class %>

  <%= render "shared/page_heading",
        title: @user.full_name,
        subtitle: @user.email,
        heading_class: "mt-2" %>

  <%= render "moderation/shared/nav" %>

  <%= form_with model: @user, url: moderation_user_path(@user), method: :patch, html: { class: "space-y-4 rounded-lg border border-gray-200 bg-white p-4" } do |form| %>
    <% if @user.errors.any? %>
      <div class="<%= error_alert_class %>">
        <%= @user.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= form.label :role, "Rol", class: filter_label_class.sub("text-xs", "text-sm") %>
      <%= form.select :role,
            policy(@user).assignable_roles.map { |role| [ user_role_label(role), role ] },
            {},
            class: filter_input_class %>
    </div>

    <div class="flex items-center gap-2">
      <%= form.check_box :active, class: checkbox_class %>
      <%= form.label :active, "Cuenta activa", class: "text-sm text-gray-700" %>
    </div>

    <%= form.submit "Guardar cambios", class: primary_button_class %>
  <% end %>
</div>
