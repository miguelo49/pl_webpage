<div class="space-y-6">
  <div>
    <h2 class="text-xl font-semibold text-gray-900">Moderación</h2>
    <p class="mt-1 text-sm text-gray-500">Reportes enviados por la comunidad.</p>
  </div>

  <%= render "moderation/shared/nav" %>

  <section class="space-y-3">
    <h3 class="text-base font-semibold text-gray-900">Reportes (<%= @reports.size %>)</h3>

    <% if @reports.any? %>
      <div class="space-y-3">
        <% @reports.each do |report| %>
          <article class="rounded-lg border border-gray-200 bg-white p-4">
            <div class="flex items-start justify-between gap-3">
              <span class="rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700">
                <%= report.reportable_type.underscore.humanize %>
              </span>
              <time class="shrink-0 text-xs text-gray-400" datetime="<%= report.created_at.iso8601 %>">
                <%= report.created_at.to_fs(:short) %>
              </time>
            </div>

            <p class="mt-3 text-sm text-gray-700"><%= report.reason %></p>
            <p class="mt-2 text-xs text-gray-400">
              Reportado por <%= report.user.first_name %>
            </p>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="rounded-lg border border-dashed border-gray-300 bg-white p-6 text-center text-sm text-gray-500">
        No hay reportes registrados.
      </p>
    <% end %>
  </section>
</div>
