<div id="moderation_queue_item_<%= entry.record.class.name %>_<%= entry.record.id %>" class="rounded-lg border border-gray-200 bg-white p-4 space-y-3">
  <div class="flex items-start justify-between gap-3">
    <div>
      <span class="rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-800"><%= entry.kind %></span>
      <h3 class="mt-2 text-base font-semibold text-gray-900"><%= entry.title %></h3>
    </div>
    <time class="shrink-0 text-xs text-gray-500" datetime="<%= entry.created_at.iso8601 %>">
      <%= entry.created_at.to_fs(:short) %>
    </time>
  </div>

  <p class="line-clamp-3 text-sm text-gray-700"><%= entry.excerpt %></p>
  <p class="text-xs text-gray-500">Por <%= entry.author.first_name %></p>

  <% if local_assigns[:error_message].present? %>
    <div class="<%= error_alert_class %> px-3 py-2">
      <%= error_message %>
    </div>
  <% end %>

  <%= form_with url: moderation_item_path_for(entry.record),
        method: :patch,
        html: { class: "space-y-3" } do |form| %>
    <div>
      <%= form.label :decision, "Acción", class: filter_label_class %>
      <%= form.select :decision,
            [
              [ "Aprobar", "approve" ],
              [ "Rechazar", "reject" ],
              [ "Ocultar", "hide" ]
            ],
            {},
            class: filter_input_class %>
    </div>

    <div>
      <%= form.label :rejection_reason, "Motivo de rechazo", class: filter_label_class %>
      <%= form.text_area :rejection_reason,
            rows: 2,
            class: filter_input_class,
            placeholder: "Obligatorio al rechazar" %>
    </div>

    <%= form.submit "Resolver", class: primary_button_class, data: { turbo_stream: true } %>
  <% end %>
</div>
