<div id="moderation_queue_item_<%= entry.record.class.name %>_<%= entry.record.id %>" class="rounded-lg border border-gray-200 bg-white p-4 space-y-3">
  <div class="flex items-start justify-between gap-3">
    <div>
      <span class="rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700"><%= entry.kind %></span>
      <h3 class="mt-2 text-base font-semibold text-gray-900"><%= entry.title %></h3>
    </div>
    <time class="shrink-0 text-xs text-gray-400" datetime="<%= entry.created_at.iso8601 %>">
      <%= entry.created_at.to_fs(:short) %>
    </time>
  </div>

  <p class="line-clamp-3 text-sm text-gray-600"><%= entry.excerpt %></p>
  <p class="text-xs text-gray-400">Por <%= entry.author.first_name %></p>

  <% if local_assigns[:error_message].present? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800">
      <%= error_message %>
    </div>
  <% end %>

  <%= form_with url: moderation_item_path_for(entry.record),
        method: :patch,
        html: { class: "space-y-3" } do |form| %>
    <div>
      <%= form.label :decision, "Acción", class: "mb-1 block text-xs font-medium text-gray-600" %>
      <%= form.select :decision,
            [
              [ "Aprobar", "approve" ],
              [ "Rechazar", "reject" ],
              [ "Ocultar", "hide" ]
            ],
            {},
            class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" %>
    </div>

    <div>
      <%= form.label :rejection_reason, "Motivo de rechazo", class: "mb-1 block text-xs font-medium text-gray-600" %>
      <%= form.text_area :rejection_reason,
            rows: 2,
            class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500",
            placeholder: "Obligatorio al rechazar" %>
    </div>

    <%= form.submit "Resolver",
          class: "w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700",
          data: { turbo_stream: true } %>
  <% end %>
</div>
