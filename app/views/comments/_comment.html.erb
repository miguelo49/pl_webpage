<% reply = local_assigns.fetch(:reply, comment.reply?) %>
<% wrapper_class = reply ? discussion_reply_class : discussion_comment_class %>
<% avatar_size = reply ? :sm : :md %>

<div id="<%= dom_id(comment) %>"
     class="<%= wrapper_class %> flex overflow-hidden"
     data-controller="reply-toggle">
  <div class="shrink-0 border-r border-gray-100 py-2">
    <%= render "reactions/vote",
          reactable: comment,
          react_path: react_path_for(comment, topic: local_assigns[:topic], thread: local_assigns[:thread], initiative: local_assigns[:initiative]) %>
  </div>

  <div class="min-w-0 flex-1 p-3">
    <%= render "shared/author_meta", user: comment.user, created_at: comment.created_at, avatar_size: avatar_size %>

    <p class="mt-2 text-sm leading-relaxed text-gray-800"><%= comment.body %></p>

  <% unless reply %>
    <div class="mt-2 flex flex-wrap items-center gap-1">
      <button type="button"
            class="<%= discussion_action_class %>"
            data-action="click->reply-toggle#toggle">
        Responder
      </button>
    </div>

    <div class="mt-3 hidden" data-reply-toggle-target="form">
      <%= render "comments/reply_form",
            comment: comment.commentable.comments.build(parent: comment),
            parent: comment,
            topic: local_assigns[:topic],
            thread: local_assigns[:thread],
            initiative: local_assigns[:initiative] %>
    </div>

    <div id="replies_<%= comment.id %>" class="mt-3 space-y-2 border-l-2 border-primary/15 pl-3">
      <% comment.replies.each do |reply_comment| %>
        <%= render "comments/comment",
              comment: reply_comment,
              reply: true,
              topic: local_assigns[:topic],
              thread: local_assigns[:thread],
              initiative: local_assigns[:initiative] %>
      <% end %>
    </div>
  <% end %>
  </div>
</div>
