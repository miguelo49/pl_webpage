<div id="<%= dom_id(comment) %>" class="rounded-lg border border-gray-200 bg-white p-4 font-brand">
  <div class="flex items-center justify-between gap-2 text-xs text-gray-500">
    <span class="font-medium text-gray-700"><%= comment.user.first_name %></span>
    <time datetime="<%= comment.created_at.iso8601 %>"><%= comment.created_at.to_fs(:short) %></time>
  </div>
  <p class="mt-2 text-sm text-gray-700"><%= comment.body %></p>

  <div class="mt-3">
    <%= render "reactions/button",
          reactable: comment,
          react_path: react_path_for(comment, topic: local_assigns[:topic], thread: local_assigns[:thread], initiative: local_assigns[:initiative]) %>
  </div>

  <% if comment.replies.any? %>
    <div class="mt-4 space-y-3 border-l-2 border-gray-100 pl-4">
      <% comment.replies.each do |reply| %>
        <div id="<%= dom_id(reply) %>" class="rounded-lg bg-gray-50 p-3">
          <div class="flex items-center justify-between gap-2 text-xs text-gray-500">
            <span class="font-medium text-gray-700"><%= reply.user.first_name %></span>
            <time datetime="<%= reply.created_at.iso8601 %>"><%= reply.created_at.to_fs(:short) %></time>
          </div>
          <p class="mt-1 text-sm text-gray-700"><%= reply.body %></p>
          <div class="mt-2">
            <%= render "reactions/button",
                  reactable: reply,
                  react_path: react_path_for(reply, topic: local_assigns[:topic], thread: local_assigns[:thread], initiative: local_assigns[:initiative]) %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
