<%= form_with model: comment,
      url: comment_form_url(initiative: local_assigns[:initiative], topic: local_assigns[:topic], thread: local_assigns[:thread]),
      html: { data: { turbo_frame: "comments" }, class: "space-y-3" } do |form| %>
  <% if comment.errors.any? %>
    <div class="<%= error_alert_class %>">
      <ul class="list-inside list-disc space-y-1">
        <% comment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :body, "Tu comentario", class: filter_label_class.sub("text-xs", "text-sm") %>
    <%= form.text_area :body, rows: 3, class: filter_input_class, placeholder: "Escribe un comentario..." %>
  </div>

  <%= form.submit "Comentar", class: primary_button_class %>
<% end %>
