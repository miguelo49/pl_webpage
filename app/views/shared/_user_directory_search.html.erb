<%= form_with url: local_assigns[:search_path], method: :get, html: { class: "flex flex-col gap-2 sm:flex-row sm:items-end" } do %>
  <div class="flex-1">
    <%= label_tag :q, "Buscar por correo o RUT", class: filter_label_class %>
    <%= text_field_tag :q, @query, class: filter_input_class, placeholder: "correo@ejemplo.com o 12.345.678-5" %>
  </div>
  <div class="flex gap-2">
    <%= submit_tag "Buscar", class: secondary_button_class(full_width: false) + " min-h-11 px-4" %>
    <% if @query.present? %>
      <%= link_to "Limpiar", local_assigns[:search_path], class: secondary_button_class(full_width: false) + " min-h-11 px-4" %>
    <% end %>
  </div>
<% end %>
