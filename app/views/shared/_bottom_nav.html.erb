<nav class="bottom-nav fixed inset-x-0 bottom-0 z-20 border-t border-gray-300 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/90 lg:hidden" aria-label="Navegación principal">
  <div class="flex h-16 w-full items-stretch justify-around px-2">
    <% NavigationHelper::BOTTOM_NAV_ITEMS.each do |item| %>
      <% active = bottom_nav_active?(item) %>
      <%= link_to bottom_nav_path(item),
            class: bottom_nav_link_class(active),
            aria: { current: (active ? "page" : nil) } do %>
        <span class="flex h-6 w-6 items-center justify-center rounded-md <%= nav_icon_class(active) %>" aria-hidden="true">
          <%= bottom_nav_icon(item[:key]) %>
        </span>
        <span><%= item[:label] %></span>
      <% end %>
    <% end %>
  </div>
</nav>
