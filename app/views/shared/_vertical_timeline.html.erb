<section class="rounded-lg border border-gray-200 bg-white p-4">
  <h3 class="text-base font-semibold text-gray-900"><%= title %></h3>

  <% if items.any? %>
    <ol class="mt-4 space-y-0">
      <% items.each_with_index do |item, index| %>
        <li class="relative flex gap-3 pb-6 last:pb-0">
          <% unless index == items.size - 1 %>
            <span class="absolute left-[7px] top-3 h-full w-px bg-gray-200" aria-hidden="true"></span>
          <% end %>

          <span class="relative mt-1 h-3.5 w-3.5 shrink-0 rounded-full border-2 <%= item.fetch(:dot_class, "border-blue-500") %> bg-white <%= item[:dot_fill_class] %>" aria-hidden="true"></span>

          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium <%= item.fetch(:title_class, "text-gray-900") %>"><%= item[:title] %></p>
            <% if item[:meta].present? %>
              <p class="mt-1 text-xs text-gray-500"><%= item[:meta] %></p>
            <% end %>
          </div>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="mt-3 text-sm text-gray-500"><%= empty_message %></p>
  <% end %>
</section>
