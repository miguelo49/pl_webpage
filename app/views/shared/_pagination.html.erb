<% if total_pages > 1 %>
  <% turbo_frame = local_assigns[:turbo_frame] %>
  <% link_data = turbo_frame.present? ? { turbo_frame: turbo_frame } : {} %>
  <% prev_params = extra_params.merge(page: page - 1) %>
  <% next_params = extra_params.merge(page: page + 1) %>

  <nav class="flex items-center justify-between gap-3 pt-2" aria-label="Paginación">
    <% if page > 1 %>
      <%= link_to "← Anterior",
            public_send(path, **prev_params),
            class: secondary_button_class + " px-3 py-2 text-sm",
            data: link_data %>
    <% else %>
      <span class="rounded-lg border border-transparent px-3 py-2 text-sm text-gray-400" aria-hidden="true">← Anterior</span>
    <% end %>

    <span class="text-xs text-gray-600">Página <%= page %> de <%= total_pages %></span>

    <% if page < total_pages %>
      <%= link_to "Siguiente →",
            public_send(path, **next_params),
            class: secondary_button_class + " px-3 py-2 text-sm",
            data: link_data %>
    <% else %>
      <span class="rounded-lg border border-transparent px-3 py-2 text-sm text-gray-400" aria-hidden="true">Siguiente →</span>
    <% end %>
  </nav>
<% end %>
