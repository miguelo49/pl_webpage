<% reacted = reacted_by_current_user?(reactable) %>
<% reaction_label = local_assigns.fetch(:label, "Me parece útil") %>
<%= turbo_frame_tag dom_id(reactable, :reaction) do %>
  <%= button_to react_path,
        method: :post,
        class: pill_button_class(active: reacted, active_style: :primary),
        form: { data: { turbo_stream: true } } do %>
    <span><%= reactable.reactions.size %></span>
    <span><%= reaction_label %></span>
  <% end %>
<% end %>
