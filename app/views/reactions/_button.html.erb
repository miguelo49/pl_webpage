<% reacted = reacted_by_current_user?(reactable) %>
<%= turbo_frame_tag dom_id(reactable, :reaction) do %>
  <%= button_to react_path,
        method: :post,
        class: "inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium transition #{reacted ? 'border-blue-200 bg-blue-50 text-blue-700' : 'border-gray-200 bg-white text-gray-600 hover:border-blue-200 hover:text-blue-700'}",
        form: { data: { turbo_stream: true } } do %>
    <span><%= reactable.reactions.size %></span>
    <span>Me parece útil</span>
  <% end %>
<% end %>
