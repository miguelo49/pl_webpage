<div class="space-y-6">
  <%= link_to "← Propuestas de ley", law_proposals_path, class: text_link_class %>

  <div>
    <%= render "shared/page_heading", title: @law_proposal.name %>
    <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-gray-500">
      <span class="rounded-full bg-gray-100 px-2 py-0.5 font-medium text-gray-700"><%= @law_proposal.category %></span>
      <span class="rounded-full px-2 py-0.5 font-medium <%= law_proposal_status_badge_class(@law_proposal.status) %>">
        <%= law_proposal_status_label(@law_proposal.status) %>
      </span>
      <span><%= @law_proposal.user.first_name %></span>
      <span>·</span>
      <span><%= @law_proposal.commune.name %></span>
    </div>
  </div>

  <%= render "law_proposals/status_timeline", law_proposal: @law_proposal %>

  <article class="space-y-4 rounded-lg border border-gray-200 bg-white p-4">
    <section>
      <h3 class="text-sm font-semibold text-gray-900">Problema</h3>
      <p class="mt-2 text-sm text-gray-700"><%= simple_format(@law_proposal.problem) %></p>
    </section>

    <section>
      <h3 class="text-sm font-semibold text-gray-900">Fundamentación</h3>
      <p class="mt-2 text-sm text-gray-700"><%= simple_format(@law_proposal.rationale) %></p>
    </section>

    <section>
      <h3 class="text-sm font-semibold text-gray-900">Objetivo</h3>
      <p class="mt-2 text-sm text-gray-700"><%= simple_format(@law_proposal.objective) %></p>
    </section>
  </article>

  <%= render "law_proposals/text_panel",
        law_proposal: @law_proposal,
        versions: @versions,
        displayed_text: @displayed_text,
        viewing_historical_version: @viewing_historical_version,
        selected_version_id: params[:version_id].to_s %>
</div>
