<section class="rounded-lg border border-gray-200 bg-white p-4 space-y-3">
  <div>
    <h3 class="text-base font-semibold text-gray-900">Texto de la propuesta</h3>
    <p class="mt-1 text-xs text-gray-500">Navega versiones anteriores sin modificar el texto vigente.</p>
  </div>

  <% if versions.any? %>
    <%= form_with url: law_proposal_path(law_proposal), method: :get, html: { class: "space-y-3" } do |form| %>
      <%= form.label :version_id, "Versión", class: "mb-1 block text-xs font-medium text-gray-600" %>
      <%= form.select :version_id,
            law_proposal_version_options(law_proposal, versions),
            { selected: selected_version_id },
            class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500",
            onchange: "this.form.requestSubmit()" %>
    <% end %>
  <% end %>

  <% if viewing_historical_version %>
    <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
      Estás viendo una versión anterior en solo lectura.
      <%= link_to "Ver texto actual", law_proposal_path(law_proposal), class: "font-semibold underline hover:text-amber-950" %>
    </div>
  <% end %>

  <div class="rounded-lg <%= viewing_historical_version ? 'bg-gray-50 border border-gray-200' : 'bg-white' %> p-4">
    <div class="prose prose-sm max-w-none whitespace-pre-wrap text-gray-700"><%= displayed_text %></div>
  </div>

  <details class="rounded-lg border border-gray-100 bg-gray-50 p-3">
    <summary class="cursor-pointer text-sm font-medium text-gray-700">Texto vigente actual</summary>
    <div class="prose prose-sm mt-3 max-w-none whitespace-pre-wrap text-gray-600"><%= law_proposal.current_text %></div>
  </details>
</section>
