<section class="rounded-lg border border-gray-200 bg-white p-4 space-y-3">
  <div>
    <h3 class="text-base font-semibold text-gray-900">Texto de la propuesta</h3>
    <p class="mt-1 text-xs text-gray-600">Navega versiones anteriores sin modificar el texto vigente.</p>
  </div>

  <% if versions.any? %>
    <%= form_with url: law_proposal_path(law_proposal), method: :get, html: { class: "space-y-3" } do |form| %>
      <%= form.label :version_id, "Versión", class: filter_label_class %>
      <%= form.select :version_id,
            law_proposal_version_options(law_proposal, versions),
            { selected: selected_version_id },
            class: filter_input_class,
            onchange: "this.form.requestSubmit()" %>
    <% end %>
  <% end %>

  <% if viewing_historical_version %>
    <div class="rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-950">
      Estás viendo una versión anterior en solo lectura.
      <%= link_to "Ver texto actual", law_proposal_path(law_proposal), class: text_link_class + " font-semibold" %>
    </div>
  <% end %>

  <div class="rounded-lg <%= viewing_historical_version ? 'bg-gray-50 border border-gray-200' : 'bg-white' %> p-4">
    <div class="prose prose-sm max-w-none whitespace-pre-wrap text-gray-800"><%= displayed_text %></div>
  </div>

  <details class="rounded-lg border border-gray-200 bg-gray-50 p-3">
    <summary class="cursor-pointer text-sm font-medium text-gray-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">Texto vigente actual</summary>
    <div class="prose prose-sm mt-3 max-w-none whitespace-pre-wrap text-gray-700"><%= law_proposal.current_text %></div>
  </details>
</section>
