<div class="space-y-6">
  <%= render "shared/page_heading",
        title: "Propuestas de ley",
        liberal: true,
        subtitle: "Borradores normativos en desarrollo colaborativo." %>

  <div class="<%= filter_sticky_class %>">
    <%= form_with url: law_proposals_path, method: :get, html: { class: "space-y-3" } do |form| %>
      <div>
        <%= form.label :commune_id, "Territorio", class: filter_label_class %>
        <%= form.select :commune_id,
              options_from_collection_for_select(@communes, :id, :name, @selected_commune_id),
              { include_blank: "Todas las comunas" },
              class: filter_input_class,
              onchange: "this.form.requestSubmit()" %>
      </div>

      <div>
        <%= form.label :category, "Categoría", class: filter_label_class %>
        <%= form.select :category,
              @categories.map { |category| [ category, category ] },
              { include_blank: "Todas las categorías", selected: @selected_category },
              class: filter_input_class,
              onchange: "this.form.requestSubmit()" %>
      </div>

      <div>
        <%= form.label :status, "Estado", class: filter_label_class %>
        <%= form.select :status,
              LawProposal.statuses.keys.map { |key| [ law_proposal_status_label(key), key ] },
              { include_blank: "Todos los estados", selected: @selected_status },
              class: filter_input_class,
              onchange: "this.form.requestSubmit()" %>
      </div>
    <% end %>
  </div>

  <% if @law_proposals.any? %>
    <div class="<%= listing_grid_class %>">
      <% @law_proposals.each do |law_proposal| %>
        <%= render "law_proposals/law_proposal_card", law_proposal: law_proposal %>
      <% end %>
    </div>
  <% else %>
    <p class="rounded-lg border border-dashed border-gray-300 bg-white p-6 text-center text-sm text-gray-500">
      No hay propuestas de ley con esos filtros.
    </p>
  <% end %>
</div>
