<%= link_to law_proposal_path(law_proposal), class: "block rounded-lg border border-gray-200 bg-white p-4 transition hover:border-blue-200 hover:shadow-sm" do %>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-base font-semibold text-gray-900"><%= law_proposal.name %></h3>
    <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-medium <%= law_proposal_status_badge_class(law_proposal.status) %>">
      <%= law_proposal_status_label(law_proposal.status) %>
    </span>
  </div>

  <p class="mt-2 line-clamp-2 text-sm text-gray-600"><%= law_proposal.objective %></p>

  <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-gray-400">
    <span class="rounded-full bg-gray-100 px-2 py-0.5 font-medium text-gray-600"><%= law_proposal.category %></span>
    <span><%= law_proposal.commune.name %></span>
    <span>·</span>
    <span><%= law_proposal.user.first_name %></span>
  </div>
<% end %>
