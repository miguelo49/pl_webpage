<%= link_to law_proposal_path(law_proposal), class: card_link_class + " hover:shadow-md" do %>
  <div class="flex items-start justify-between gap-3">
    <h3 class="<%= card_title_class %>"><%= law_proposal.name %></h3>
    <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-medium <%= law_proposal_status_badge_class(law_proposal.status) %>">
      <%= law_proposal_status_label(law_proposal.status) %>
    </span>
  </div>

  <p class="mt-2 line-clamp-2 text-sm text-gray-700"><%= law_proposal.objective %></p>

  <div class="mt-3 flex flex-wrap items-center gap-2 <%= card_meta_class %>">
    <span class="<%= category_chip_class %>"><%= law_proposal.category %></span>
    <span><%= law_proposal.commune.name %></span>
    <span>·</span>
    <span><%= law_proposal.user.first_name %></span>
  </div>
<% end %>
