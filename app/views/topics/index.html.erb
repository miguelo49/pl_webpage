<div class="space-y-6">
  <div>
    <h2 class="text-xl font-semibold text-gray-900">Comunidad</h2>
    <p class="mt-1 text-sm text-gray-500">Elige un tópico para ver los hilos de conversación.</p>
  </div>

  <div class="space-y-3">
    <% @topics.each do |topic| %>
      <%= link_to topic_threads_path(topic), class: "block rounded-lg border border-gray-200 bg-white p-4 shadow-sm transition hover:border-blue-200 hover:bg-blue-50/40" do %>
        <h3 class="text-base font-semibold text-gray-900"><%= topic.name %></h3>
        <% if topic.description.present? %>
          <p class="mt-1 text-sm text-gray-500"><%= topic.description %></p>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
