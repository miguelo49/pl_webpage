<div class="space-y-6">
  <%= render "shared/page_heading",
        title: "Foro",
        subtitle: "Elige un tópico para ver los hilos de conversación." %>

  <div class="<%= listing_grid_class %>">
    <% @topics.each do |topic| %>
      <%= link_to topic_threads_path(topic), class: card_link_class + " #{card_hover_class}" do %>
        <h3 class="<%= card_title_class %>"><%= topic.name %></h3>
        <% if topic.description.present? %>
          <p class="mt-1 text-sm text-gray-500"><%= topic.description %></p>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
