<section class="rounded-lg border border-gray-200 bg-white p-4">
  <h3 class="text-base font-semibold text-gray-900">Historial de estado</h3>

  <% if state_changes.any? %>
    <ol class="mt-4 space-y-0">
      <% state_changes.each_with_index do |state_change, index| %>
        <li class="relative flex gap-3 pb-6 last:pb-0">
          <% unless index == state_changes.size - 1 %>
            <span class="absolute left-[7px] top-3 h-full w-px bg-gray-200" aria-hidden="true"></span>
          <% end %>

          <span class="relative mt-1 h-3.5 w-3.5 shrink-0 rounded-full border-2 border-blue-500 bg-white" aria-hidden="true"></span>

          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-gray-900">
              <%= initiative_status_label(state_change.previous_status) %>
              <span class="font-normal text-gray-400">→</span>
              <%= initiative_status_label(state_change.new_status) %>
            </p>
            <p class="mt-1 text-xs text-gray-500">
              <%= state_change.user.first_name %>
              <span>·</span>
              <time datetime="<%= state_change.created_at.iso8601 %>"><%= state_change.created_at.to_fs(:short) %></time>
            </p>
          </div>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="mt-3 text-sm text-gray-500">Aún no hay cambios de estado registrados.</p>
  <% end %>
</section>
