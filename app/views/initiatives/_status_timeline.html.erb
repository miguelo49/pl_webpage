<%= render "shared/vertical_timeline",
      title: "Historial de estado",
      items: state_changes.map { |state_change|
        {
          title: "#{initiative_status_label(state_change.previous_status)} → #{initiative_status_label(state_change.new_status)}",
          meta: "#{state_change.user.first_name} · #{state_change.created_at.to_fs(:short)}"
        }
      },
      empty_message: "Aún no hay cambios de estado registrados." %>
