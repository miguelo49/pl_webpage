<%= link_to initiative_path(initiative), class: card_link_class + " hover:shadow-md" do %>
  <div class="flex items-start justify-between gap-3">
    <h3 class="<%= card_title_class %>"><%= initiative.title %></h3>
    <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-medium <%= initiative_status_badge_class(initiative.status) %>">
      <%= initiative_status_label(initiative.status) %>
    </span>
  </div>

  <p class="mt-2 line-clamp-2 text-sm text-gray-700"><%= initiative.description %></p>

  <div class="mt-3 flex flex-wrap items-center gap-2 <%= card_meta_class %>">
    <span class="<%= category_chip_class %>"><%= initiative.category %></span>
    <span><%= initiative.commune.name %></span>
    <span>·</span>
    <span><%= initiative.user.first_name %></span>
    <span>·</span>
    <span><%= initiative.reactions.size %> apoyos</span>
  </div>
<% end %>
