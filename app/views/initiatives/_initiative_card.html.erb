<%= link_to initiative_path(initiative), class: "block rounded-lg border border-gray-200 bg-white p-4 transition hover:border-blue-200 hover:shadow-sm" do %>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-base font-semibold text-gray-900"><%= initiative.title %></h3>
    <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-medium <%= initiative_status_badge_class(initiative.status) %>">
      <%= initiative_status_label(initiative.status) %>
    </span>
  </div>

  <p class="mt-2 line-clamp-2 text-sm text-gray-600"><%= initiative.description %></p>

  <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-gray-400">
    <span class="rounded-full bg-gray-100 px-2 py-0.5 font-medium text-gray-600"><%= initiative.category %></span>
    <span><%= initiative.commune.name %></span>
    <span>·</span>
    <span><%= initiative.user.first_name %></span>
    <span>·</span>
    <span><%= initiative.reactions.size %> apoyos</span>
  </div>
<% end %>
