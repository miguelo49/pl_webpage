<div class="mx-auto flex w-full max-w-md flex-col justify-center space-y-6 py-6">
  <%= turbo_frame_tag "onboarding_progress" do %>
    <%= render "progress", current_step: @current_step %>
  <% end %>

  <%= turbo_frame_tag "onboarding_step" do %>
    <%= render "step", current_step: @current_step %>
  <% end %>
</div>
