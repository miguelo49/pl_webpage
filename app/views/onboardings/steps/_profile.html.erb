<div class="space-y-6">
  <div>
    <h2 class="text-xl font-semibold text-gray-900">Tu perfil</h2>
    <p class="mt-1 text-sm text-gray-500">Indica tu nombre y apellido para continuar.</p>
  </div>

  <%= form_with model: current_user, url: onboarding_path, method: :patch, data: { turbo_frame: "onboarding_step" }, class: "space-y-4" do |form| %>
    <% if current_user.errors.any? %>
      <div class="<%= error_alert_class %>">
        <ul class="list-inside list-disc space-y-1">
          <% current_user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :first_name, "Nombre", class: form_label_class %>
      <%= form.text_field :first_name, autofocus: true, autocomplete: "given-name", class: filter_input_class %>
    </div>

    <div>
      <%= form.label :last_name, "Apellido", class: form_label_class %>
      <%= form.text_field :last_name, autocomplete: "family-name", class: filter_input_class %>
    </div>

    <%= render "shared/commune_fields", form: form, regions: @regions %>

    <%= form.submit "Continuar", class: primary_button_class %>
  <% end %>
</div>
