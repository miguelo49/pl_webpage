<% form_url = @news_item.persisted? ? news_path(@news_item) : news_index_path %>
<% submit_label = @news_item.persisted? ? "Guardar cambios" : "Publicar noticia" %>

<%= form_with model: @news_item, url: form_url, html: { multipart: true, class: "space-y-4" } do |form| %>
  <% if @news_item.errors.any? %>
    <div class="<%= error_alert_class %>">
      <ul class="list-inside list-disc space-y-1">
        <% @news_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Título", class: form_label_class %>
    <%= form.text_field :title, class: filter_input_class, autofocus: true %>
  </div>

  <div>
    <%= form.label :summary, "Resumen", class: form_label_class %>
    <%= form.text_area :summary, rows: 3, class: filter_input_class %>
  </div>

  <div>
    <%= form.label :body, "Contenido", class: form_label_class %>
    <%= form.text_area :body, rows: 8, class: filter_input_class %>
  </div>

  <div>
    <%= form.label :category, "Categoría", class: form_label_class %>
    <%= form.select :category,
          News.categories.keys.map { |key| [ news_category_label(key), key ] },
          { prompt: "Selecciona una categoría" },
          class: filter_input_class %>
  </div>

  <div>
    <%= form.label :published_at, "Fecha de publicación", class: form_label_class %>
    <%= form.datetime_local_field :published_at, class: filter_input_class %>
  </div>

  <div>
    <%= form.label :featured_image, "Imagen destacada (opcional)", class: form_label_class %>

    <% if @news_item.featured_image.attached? %>
      <div class="mb-3">
        <%= image_tag @news_item.featured_image.variant(resize_to_limit: [ 400, 225 ]),
              class: "aspect-video w-full max-w-md rounded-lg object-cover",
              alt: "Imagen destacada actual" %>
      </div>

      <label class="mb-3 flex items-center gap-2 text-sm text-gray-700">
        <%= form.check_box :remove_featured_image, class: checkbox_class %>
        Eliminar imagen destacada
      </label>
    <% end %>

    <%= form.file_field :featured_image, accept: "image/jpeg,image/png,image/webp,image/gif", class: file_input_class %>
  </div>

  <%= form.submit submit_label, class: primary_button_class %>
<% end %>
