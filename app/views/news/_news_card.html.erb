<%= link_to news_path(news_item), class: "block overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm transition hover:border-blue-200" do %>
  <% if news_item.featured_image.attached? %>
    <%= image_tag news_item.featured_image.variant(resize_to_fill: [ 640, 360 ]),
          class: "aspect-video w-full object-cover",
          alt: "" %>
  <% end %>

  <div class="p-4">
    <div class="flex items-center justify-between gap-2 text-xs text-gray-400">
      <span class="rounded-full bg-gray-100 px-2 py-0.5 font-medium text-gray-600"><%= news_category_label(news_item.category) %></span>
      <time datetime="<%= (news_item.published_at || news_item.created_at).iso8601 %>">
        <%= (news_item.published_at || news_item.created_at).to_fs(:short) %>
      </time>
    </div>

    <h3 class="mt-2 text-base font-semibold text-gray-900"><%= news_item.title %></h3>
    <p class="mt-2 line-clamp-3 text-sm text-gray-600"><%= news_item.summary %></p>
  </div>
<% end %>
