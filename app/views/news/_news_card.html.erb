<%= link_to news_path(news_item), class: card_link_class.sub(" p-4", "") + " overflow-hidden" do %>
  <% if news_item.featured_image.attached? %>
    <%= image_tag news_item.featured_image.variant(resize_to_fill: [ 640, 360 ]),
          class: "aspect-video w-full object-cover",
          alt: "" %>
  <% end %>

  <div class="p-4">
    <div class="flex items-center justify-between gap-2 <%= card_meta_class %>">
      <span class="<%= category_chip_class %>"><%= news_category_label(news_item.category) %></span>
      <time datetime="<%= (news_item.published_at || news_item.created_at).iso8601 %>">
        <%= (news_item.published_at || news_item.created_at).to_fs(:short) %>
      </time>
    </div>

    <h3 class="mt-2 <%= card_title_class %>"><%= news_item.title %></h3>
    <p class="mt-2 line-clamp-3 text-sm text-gray-700"><%= news_item.summary %></p>
  </div>
<% end %>
