<div class="space-y-6">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h2 class="text-xl font-semibold text-gray-900">Noticias</h2>
      <p class="mt-1 text-sm text-gray-500">Información del partido y la región.</p>
    </div>

    <% if policy(News.new).create? %>
      <%= link_to "Nueva noticia",
            new_news_path,
            class: "shrink-0 rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
    <% end %>
  </div>

  <div class="flex gap-2 overflow-x-auto pb-1">
    <%= link_to "Todas",
          news_index_path,
          class: "shrink-0 rounded-full border px-3 py-1 text-xs font-medium #{@selected_category.blank? ? 'border-blue-200 bg-blue-50 text-blue-700' : 'border-gray-200 bg-white text-gray-600 hover:border-blue-200'}" %>

    <% News.categories.each_key do |category| %>
      <%= link_to news_category_label(category),
            news_index_path(category: category),
            class: "shrink-0 rounded-full border px-3 py-1 text-xs font-medium #{@selected_category == category ? 'border-blue-200 bg-blue-50 text-blue-700' : 'border-gray-200 bg-white text-gray-600 hover:border-blue-200'}" %>
    <% end %>
  </div>

  <div class="space-y-3">
    <% if @news_items.any? %>
      <% @news_items.each do |news_item| %>
        <%= render "news/news_card", news_item: news_item %>
      <% end %>
    <% else %>
      <p class="rounded-lg border border-dashed border-gray-300 bg-white p-6 text-center text-sm text-gray-500">
        No hay noticias en esta categoría.
      </p>
    <% end %>
  </div>

  <%= render "news/pagination",
        page: @page,
        total_pages: @total_pages,
        selected_category: @selected_category %>
</div>
