<div class="space-y-6">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h2 class="text-xl font-semibold text-gray-900">Noticias</h2>
      <p class="mt-1 text-sm text-gray-500">Información del partido y la región.</p>
    </div>

    <% if policy(News.new).create? %>
      <%= link_to "Nueva noticia", new_news_path, class: action_link_class %>
    <% end %>
  </div>

  <div class="flex gap-2 overflow-x-auto pb-1">
    <%= link_to "Todas",
          news_index_path,
          class: chip_filter_class(active: @selected_category.blank?) %>

    <% News.categories.each_key do |category| %>
      <%= link_to news_category_label(category),
            news_index_path(category: category),
            class: chip_filter_class(active: @selected_category == category) %>
    <% end %>
  </div>

  <div class="space-y-3">
    <% if @news_items.any? %>
      <% @news_items.each do |news_item| %>
        <%= render "news/news_card", news_item: news_item %>
      <% end %>
    <% else %>
      <p class="rounded-lg border border-dashed border-gray-300 bg-white p-6 text-center text-sm text-gray-500">
        No hay noticias en esta categoría.
      </p>
    <% end %>
  </div>

  <%= render "news/pagination",
        page: @page,
        total_pages: @total_pages,
        selected_category: @selected_category %>
</div>
