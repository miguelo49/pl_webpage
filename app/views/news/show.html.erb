<div class="space-y-6">
  <%= link_to "← Noticias", news_index_path, class: "text-sm text-blue-600 hover:text-blue-800" %>

  <% if @news_item.featured_image.attached? %>
    <%= image_tag @news_item.featured_image.variant(resize_to_limit: [ 800, 450 ]),
          class: "aspect-video w-full rounded-lg object-cover",
          alt: "" %>
  <% end %>

  <div>
    <div class="flex flex-wrap items-center gap-2 text-xs text-gray-400">
      <span class="rounded-full bg-gray-100 px-2 py-0.5 font-medium text-gray-600"><%= news_category_label(@news_item.category) %></span>
      <span><%= @news_item.user.first_name %></span>
      <span>·</span>
      <time datetime="<%= (@news_item.published_at || @news_item.created_at).iso8601 %>">
        <%= (@news_item.published_at || @news_item.created_at).to_fs(:short) %>
      </time>
    </div>

    <h2 class="mt-3 text-xl font-semibold text-gray-900"><%= @news_item.title %></h2>
    <p class="mt-3 text-sm font-medium text-gray-700"><%= @news_item.summary %></p>
  </div>

  <article class="rounded-lg border border-gray-200 bg-white p-4">
    <div class="prose prose-sm max-w-none text-gray-700">
      <%= simple_format(@news_item.body) %>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-2">
      <%= render "reactions/button",
            reactable: @news_item,
            react_path: react_path_for(@news_item) %>

      <div data-controller="share"
           data-share-url-value="<%= news_url(@news_item) %>"
           data-share-title-value="<%= @news_item.title %>"
           data-share-text-value="<%= @news_item.summary %>"
           class="inline-flex items-center gap-2">
        <button type="button"
              data-share-target="button"
              data-action="click->share#share"
              class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-3 py-1 text-xs font-medium text-gray-600 transition hover:border-green-200 hover:text-green-700">
          Compartir
        </button>
        <span data-share-target="feedback" class="hidden text-xs text-green-700" aria-live="polite"></span>
      </div>
    </div>
  </article>

  <% if @thread.present? %>
    <%= turbo_frame_tag "comments" do %>
      <section class="space-y-4">
        <h3 class="text-base font-semibold text-gray-900">Discusión</h3>

        <div id="comments_list" class="space-y-4">
          <% if @comments.any? %>
            <% @comments.each do |comment| %>
              <%= render "comments/comment", comment: comment, topic: @topic, thread: @thread %>
            <% end %>
          <% else %>
            <p class="text-sm text-gray-500">Sé el primero en comentar esta noticia.</p>
          <% end %>
        </div>

        <div id="comment_form">
          <%= render "comments/form", topic: @topic, thread: @thread, comment: @comment %>
        </div>
      </section>
    <% end %>
  <% end %>
</div>
